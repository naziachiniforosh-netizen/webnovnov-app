{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webnovnov-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9430c876-1811-4f19-b464-1bd6b24fbf50","database_name": "webnovnov-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0247bad91eda443eaeadf249a6865210" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
